# The controller it dials : its address as people open it
CONTROLLER_URL=https://forms.example.com
# 0 accepts the controller's self-signed certificate, in one trusted network only
CONTROLLER_TLS_VERIFY=1
# its own token, at least 16 characters : the controller keeps it for it once it joins
RTE_TOKEN=change-me-at-least-16-characters
# a join token (afj_...) that approves it at once, the first time ; else an admin approves it
RTE_JOIN_TOKEN=
# its name in the controller's RTE builders (default : builder-<hostname>-<port>)
RTE_NAME=builder-1
# another BuildKit to build with (tcp://buildkitd:1234) ; empty : its own rootless buildkitd
BUILDKIT_HOST=
# its spool, its builds' files and its buildkitd's cache
BUILDER_WORK_PATH=/home/node/work
# its /live and /ready
PORT=8000
# debug, info, notice, warning or error
LOG_LEVEL=notice
